# Copy to backend/.env and fill in.
PORT=5000
NODE_ENV=development

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-free single origin of the frontend, or * for local development
CORS_ORIGIN=*

# Redis (ride matching, locks, leader election). The app falls back to SQLite-only matching if Redis is down.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Unique per backend instance when running several
INSTANCE_ID=

# true (default outside production): auto-accept rides with a simulated driver for solo testing
DEMO_MODE=true

# Create demo logins Guru/123456 and Driver1/password (default: on outside production)
SEED_DEMO_USERS=

# Optional: AI chatbot
GEMINI_API_KEY=
